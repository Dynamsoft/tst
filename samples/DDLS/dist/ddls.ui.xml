<div class="ddls-root">
	<style>
		.ddls-root {
			--ddls-color-primary: #fe8e14;
			--ddls-color-text: #ffffff;
			--ddls-color-overlay: rgba(0, 0, 0, 0.6);
			--ddls-color-toolbar: rgba(0, 0, 0, 0.5);
			/* One accent for all scanning feedback: guide border, spinner, flip card. */
			--ddls-color-scanAccent: #ffffff;
			--ddls-color-spinnerBackground: rgba(0, 0, 0, 0.2);
			--ddls-color-success: #4caf50;
			position: relative;
			width: 100%;
			height: 100%;
			background: #000;
			font-family: system-ui, -apple-system, sans-serif;
			overflow: hidden;
		}
		.ddls-root .dm-camera-core-container {
			width: 100%;
			height: 100%;
		}
		.ddls-guide {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			width: min(78%, 62vh);
			aspect-ratio: 1.588; /* ID-1 card */
			pointer-events: none;
		}
		.ddls-guide::before {
			content: "";
			position: absolute;
			inset: 0;
			border-radius: 4.5% / 7%;
			box-shadow: 0 0 0 200vmax var(--ddls-color-overlay);
			border: 2px solid var(--ddls-color-scanAccent);
		}
		.ddls-guide.ddls-guide-success::before {
			border-color: var(--ddls-color-success);
		}
		.ddls-hint {
			position: absolute;
			left: 50%;
			bottom: 12%;
			transform: translateX(-50%);
			max-width: 90%;
			width: max-content;
			padding: 0.6em 1.2em;
			border-radius: 2em;
			background: var(--ddls-color-overlay);
			color: var(--ddls-color-text);
			font-size: 1rem;
			line-height: 1.35;
			text-align: center;
		}
		.ddls-hint:empty {
			display: none;
		}
		.ddls-loading {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1rem;
			background: #323234;
			z-index: 5;
		}
		.ddls-loading[hidden] {
			display: none;
		}
		.ddls-loading svg {
			width: 2rem;
			height: 2rem;
			color: var(--ddls-color-scanAccent);
			animation: ddls-spin 1s linear infinite;
		}
		.ddls-loading-message {
			color: var(--ddls-color-text);
			font-size: 0.9rem;
			opacity: 0.9;
		}
		@media (prefers-reduced-motion: reduce) {
			.ddls-loading svg {
				animation: none;
			}
		}
		.ddls-scan-spinner {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 56px;
			height: 56px;
			margin: -28px 0 0 -28px;
			opacity: 0;
			transition: opacity 0.15s ease;
			pointer-events: none;
			z-index: 1;
		}
		.ddls-scan-spinner.ddls-visible {
			opacity: 1;
		}
		.ddls-scan-spinner .ddls-spinner-bg {
			fill: var(--ddls-color-spinnerBackground);
		}
		.ddls-scan-spinner .ddls-spinner-inner {
			animation: ddls-spin 1.2s linear infinite;
			transform-origin: 28px 28px;
		}
		.ddls-scan-spinner .ddls-spinner-inner path {
			fill: var(--ddls-color-scanAccent);
		}
		@keyframes ddls-spin {
			from {
				transform: rotate(0deg);
			}
			to {
				transform: rotate(360deg);
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.ddls-scan-spinner .ddls-spinner-inner {
				animation: none;
			}
		}
		.ddls-flip {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--ddls-color-overlay);
			z-index: 2;
		}
		.ddls-flip[hidden] {
			display: none;
		}
		.ddls-flip-animation {
			width: 160px;
			height: 100px;
			perspective: 600px;
		}
		.ddls-flip-card {
			position: relative;
			width: 100%;
			height: 100%;
			transform-style: preserve-3d;
			/* Un-hiding the overlay re-renders the card, restarting this one-shot flip. */
			animation: ddls-card-flip 0.8s ease-in-out forwards;
		}
		.ddls-flip-card-front,
		.ddls-flip-card-back {
			position: absolute;
			width: 100%;
			height: 100%;
			backface-visibility: hidden;
			-webkit-backface-visibility: hidden;
			color: var(--ddls-color-scanAccent);
		}
		.ddls-flip-card-back {
			transform: rotateY(180deg);
		}
		@keyframes ddls-card-flip {
			0% {
				transform: rotateY(0deg);
			}
			100% {
				transform: rotateY(180deg);
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.ddls-flip-card {
				animation: none;
				transform: rotateY(180deg);
			}
		}
		.ddls-toolbar {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			display: flex;
			justify-content: space-between;
			padding: 0.75rem;
			z-index: 3;
		}
		.ddls-toolbar-group {
			display: flex;
			gap: 0.5rem;
		}
		.ddls-toolbar button {
			width: 2.75rem;
			height: 2.75rem;
			padding: 0;
			border: none;
			border-radius: 50%;
			background: var(--ddls-color-toolbar);
			color: var(--ddls-color-text);
			font-size: 1.15rem;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.ddls-toolbar button.ddls-torch-on,
		.ddls-toolbar button.ddls-sound-on,
		.ddls-toolbar button.ddls-vibrate-on {
			background: var(--ddls-color-primary);
		}
		.ddls-toolbar button svg {
			width: 1.35rem;
			height: 1.35rem;
			flex: none;
			display: block;
		}
		.ddls-confirmation {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--ddls-color-overlay);
			z-index: 4;
		}
		.ddls-confirmation[hidden] {
			display: none;
		}
		.ddls-confirmation-card {
			background: #fff;
			border-radius: 0.75rem;
			padding: 0.75rem;
			max-width: min(85%, 26rem);
			text-align: center;
		}
		.ddls-confirmation-thumb canvas {
			max-width: 100%;
			max-height: 40vh;
			border-radius: 0.4rem;
		}
		.ddls-confirmation-actions {
			display: flex;
			gap: 0.5rem;
			margin-top: 0.75rem;
		}
		.ddls-confirmation-actions button {
			flex: 1;
			padding: 0.6rem;
			font-size: 0.95rem;
			border: none;
			border-radius: 0.5rem;
			cursor: pointer;
		}
		.ddls-btn-retake {
			background: #eee;
			color: #333;
		}
		.ddls-btn-use {
			background: var(--ddls-color-primary);
			color: #fff;
		}
	</style>

